<h1 class="page-title">Bai dang</h1>

<div class="card">
  <div class="card-header">
    <span>Danh sach bai viet</span>
    <span style="font-size:12px;color:#65676b"><%= posts.length %> bai</span>
  </div>
  <div class="card-body">
    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">&#128196;</div>
        <p>Chua co bai dang nao</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Thoi gian</th>
              <th>Noi dung</th>
              <th>Hanh dong</th>
              <th>Trang thai</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(function(p) { %>
            <tr>
              <td class="log-time"><%= new Date(p.timestamp).toLocaleString('vi-VN') %></td>
              <td style="max-width:400px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                <%= p.contentId || p.postId || '-' %>
              </td>
              <td><span class="badge badge-info"><%= p.action %></span></td>
              <td>
                <% if (p.status === 'success') { %><span class="badge badge-success">OK</span><% } else { %><span class="badge badge-danger">Loi</span><% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
