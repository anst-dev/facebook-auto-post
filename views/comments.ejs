<div class="page-header">
  <h1 class="page-title">Phản hồi Comment</h1>
  <p class="page-subtitle">Quản lý phản hồi tự động theo từ khóa</p>
</div>

<!-- Control panel -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <span class="status-dot <%= config.enabled ? 'active' : 'inactive' %>"></span>
      <span>Điều khiển hệ thống</span>
    </div>
    <form method="POST" action="/comments/toggle" style="display:inline">
      <button type="submit" class="btn btn-sm <%= config.enabled ? 'btn-danger' : 'btn-success' %>">
        <%= config.enabled ? 'Tắt hệ thống' : 'Bật hệ thống' %>
      </button>
    </form>
  </div>
  <div class="card-body">
    <div class="kw-chips">
      <% config.keywords.forEach(function(kw) { %>
        <span class="kw-chip"><%= kw.keyword %></span>
      <% }) %>
      <% if (config.keywords.length === 0) { %>
        <span class="text-muted" style="font-size:13px">Chưa có từ khóa — <a href="/admin/keywords">thêm ngay</a></span>
      <% } %>
    </div>

    <div class="btn-group" style="margin-top:16px">
      <form method="POST" action="/comments/start" style="display:inline">
        <button type="submit" class="btn btn-success">▶ Bắt đầu</button>
      </form>
      <form method="POST" action="/comments/stop" style="display:inline">
        <button type="submit" class="btn btn-danger">⏹ Dừng</button>
      </form>
      <form method="POST" action="/comments/reset" style="display:inline">
        <button type="submit" class="btn btn-ghost">↻ Reset</button>
      </form>
    </div>
  </div>
</div>

<!-- Keyword configs -->
<% config.keywords.forEach(function(kw) { %>
<div class="card" style="margin-bottom:16px">
  <div class="card-header">
    <span class="kw-badge"><%= kw.keyword %></span>
  </div>
  <div class="card-body">
    <div class="field-group">
      <div class="field-label">💬 Phản hồi công khai</div>
      <div class="field-content"><%= kw.replyComment || '<em>Chưa cấu hình</em>' %></div>
    </div>
    <div class="field-group">
      <div class="field-label">✉️ Tin nhắn riêng</div>
      <div class="field-content"><%= kw.privateMessage || '<em>Chưa cấu hình</em>' %></div>
    </div>
  </div>
</div>
<% }) %>

<!-- Comment stats -->
<div class="stats-grid">
  <div class="stat-card gradient-green">
    <div class="stat-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= commentStats.totalProcessed %></div>
      <div class="stat-label">Đã xử lý</div>
    </div>
  </div>
  <div class="stat-card gradient-blue">
    <div class="stat-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= commentStats.totalReplies %></div>
      <div class="stat-label">Reply OK</div>
    </div>
  </div>
  <div class="stat-card gradient-purple">
    <div class="stat-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= commentStats.totalDMs %></div>
      <div class="stat-label">DM OK</div>
    </div>
  </div>
  <div class="stat-card gradient-red">
    <div class="stat-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= commentStats.totalDMFailed %></div>
      <div class="stat-label">DM lỗi</div>
    </div>
  </div>
</div>

<!-- Log table -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Log phản hồi
    </div>
    <span class="badge badge-ghost"><%= commentLogs.length %> mục</span>
  </div>
  <div class="card-body">
    <% if (commentLogs.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <p>Chưa có log comment nào</p>
        <p class="empty-hint">Sẽ hiển thị khi có comment mới được xử lý</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Thời gian</th>
              <th>Hành động</th>
              <th>Từ khóa</th>
              <th>Người dùng</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% commentLogs.slice(0, 30).forEach(function(log) { %>
            <tr>
              <td class="text-muted"><%= new Date(log.timestamp).toLocaleString('vi-VN') %></td>
              <td>
                <% if (log.action === 'reply') { %><span class="badge badge-blue">Reply</span><% } %>
                <% if (log.action === 'dm') { %><span class="badge badge-purple">DM</span><% } %>
              </td>
              <td><code><%= log.keyword || '-' %></code></td>
              <td><%= log.userName || '-' %></td>
              <td>
                <% if (log.status === 'success') { %>
                  <span class="badge badge-green">✓</span>
                <% } else { %>
                  <span class="badge badge-red">✗</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
