<h1 class="page-title">Comment Reply</h1>

<div class="card">
  <div class="card-header">
    <span>Cau hinh tu khoa</span>
    <form method="POST" action="/comments/toggle" style="display:inline">
      <button type="submit" class="btn btn-sm <%= config.enabled ? 'btn-danger' : 'btn-success' %>">
        <%= config.enabled ? 'Tat' : 'Bat' %>
      </button>
    </form>
  </div>
  <div class="card-body">
    <div class="keyword-list">
      <% config.keywords.forEach(function(kw) { %>
        <span class="keyword-tag"><%= kw.keyword %></span>
      <% }) %>
      <% if (config.keywords.length === 0) { %>
        <span style="color:#65676b;font-size:13px">Chua co tu khoa nao</span>
      <% } %>
    </div>

    <% config.keywords.forEach(function(kw) { %>
    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><span><%= kw.keyword %></span></div>
      <div class="card-body">
        <div class="form-group">
          <label>Reply comment (cong khai)</label>
          <textarea readonly><%= kw.replyComment %></textarea>
        </div>
        <div class="form-group">
          <label>Tin nhan rieng (DM)</label>
          <textarea readonly><%= kw.privateMessage %></textarea>
        </div>
      </div>
    </div>
    <% }) %>

    <div style="display:flex;gap:8px;margin-top:16px">
      <form method="POST" action="/comments/start" style="display:inline">
        <button type="submit" class="btn btn-success">Bat dau polling</button>
      </form>
      <form method="POST" action="/comments/stop" style="display:inline">
        <button type="submit" class="btn btn-danger">Dung polling</button>
      </form>
      <form method="POST" action="/comments/reset" style="display:inline">
        <button type="submit" class="btn btn-outline">Reset state</button>
      </form>
    </div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card green">
    <div class="stat-value"><%= commentStats.totalProcessed %></div>
    <div class="stat-label">Comment da xu ly</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= commentStats.totalReplies %></div>
    <div class="stat-label">Reply thanh cong</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= commentStats.totalDMs %></div>
    <div class="stat-label">DM thanh cong</div>
  </div>
  <div class="stat-card orange">
    <div class="stat-value"><%= commentStats.totalDMFailed %></div>
    <div class="stat-label">DM loi</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span>Log comment reply</span>
    <span style="font-size:12px;color:#65676b"><%= commentLogs.length %> muc</span>
  </div>
  <div class="card-body">
    <% if (commentLogs.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">&#128172;</div>
        <p>Chua co log comment nao</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Thoi gian</th>
              <th>Hanh dong</th>
              <th>Tu khoa</th>
              <th>User</th>
              <th>Trang thai</th>
            </tr>
          </thead>
          <tbody>
            <% commentLogs.slice(0, 30).forEach(function(log) { %>
            <tr>
              <td class="log-time"><%= new Date(log.timestamp).toLocaleString('vi-VN') %></td>
              <td>
                <% if (log.action === 'reply') { %><span class="badge badge-info">Reply</span><% } %>
                <% if (log.action === 'dm') { %><span class="badge badge-warning">DM</span><% } %>
              </td>
              <td><%= log.keyword || '-' %></td>
              <td><%= log.userName || '-' %></td>
              <td>
                <% if (log.status === 'success') { %><span class="badge badge-success">OK</span><% } else { %><span class="badge badge-danger">Loi</span><% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
