<div class="page-header">
  <h1 class="page-title">Cài đặt</h1>
  <p class="page-subtitle">Quản lý token và cấu hình Page Facebook</p>
</div>

<% if (flash) { %>
<div class="alert <%= flash.type === 'success' ? 'alert-success' : 'alert-danger' %>">
  <span><%= flash.type === 'success' ? '✓' : '✗' %></span>
  <span><%= flash.message %></span>
</div>
<% } %>

<!-- Current page info -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Thông tin Page
    </div>
  </div>
  <div class="card-body">
    <% if (tokenInfo) { %>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Tên Page</span>
          <span class="info-value"><%= tokenInfo.name || '-' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Page ID</span>
          <span class="info-value"><code><%= tokenInfo.id || '-' %></code></span>
        </div>
        <div class="info-item">
          <span class="info-label">Token</span>
          <span class="info-value">
            <span class="badge <%= tokenInfo.valid ? 'badge-green' : 'badge-red' %>">
              <span class="status-dot <%= tokenInfo.valid ? 'active' : 'inactive' %>"></span>
              <%= tokenInfo.valid ? 'Hợp lệ' : 'Hết hạn' %>
            </span>
          </span>
        </div>
        <div class="info-item">
          <span class="info-label">Độ dài</span>
          <span class="info-value"><%= tokenInfo.tokenLength || 0 %> ký tự</span>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">🔒</div>
        <p>Chưa có token</p>
        <p class="empty-hint">Nhập token bên dưới để bắt đầu</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Token form -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Cập nhật Token
    </div>
  </div>
  <div class="card-body">
    <form method="POST" action="/settings/token">
      <div class="form-group">
        <label>Page ID</label>
        <input type="text" name="pageId" value="<%= currentEnv.FACEBOOK_PAGE_ID || '' %>" placeholder="VD: 1864460076999002">
      </div>
      <div class="form-group">
        <label>Access Token</label>
        <textarea name="accessToken" rows="4" placeholder="Dán Page Access Token vào đây..."><%= currentEnv.FACEBOOK_ACCESS_TOKEN || '' %></textarea>
      </div>
      <div class="btn-group">
        <button type="submit" class="btn btn-primary">💾 Lưu & Kiểm tra</button>
        <a href="/settings" class="btn btn-ghost">Hủy</a>
      </div>
    </form>
  </div>
</div>

<!-- Guide -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      Hướng dẫn lấy Token
    </div>
  </div>
  <div class="card-body">
    <div class="guide-steps">
      <div class="guide-step">
        <div class="step-num">1</div>
        <div class="step-content">
          <p>Vào <a href="https://developers.facebook.com/tools/explorer/" target="_blank">Graph API Explorer</a></p>
        </div>
      </div>
      <div class="guide-step">
        <div class="step-num">2</div>
        <div class="step-content">
          <p>Chọn Facebook App → Chọn Page từ dropdown "User or Page"</p>
        </div>
      </div>
      <div class="guide-step">
        <div class="step-num">3</div>
        <div class="step-content">
          <p>Thêm quyền: <code>pages_manage_posts</code>, <code>pages_read_engagement</code>, <code>pages_read_user_content</code>, <code>pages_manage_engagement</code>, <code>pages_messaging</code></p>
        </div>
      </div>
      <div class="guide-step">
        <div class="step-num">4</div>
        <div class="step-content">
          <p>Click "Generate Access Token" → Copy → Dán vào form trên</p>
        </div>
      </div>
      <div class="guide-step">
        <div class="step-num">5</div>
        <div class="step-content">
          <p>Tìm Page ID tại <a href="https://www.facebook.com/settings" target="_blank">Page Settings</a> → Page Info → Page ID</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Saved pages -->
<% if (savedPages && savedPages.length > 0) { %>
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      Page đã lưu
    </div>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Tên Page</th>
            <th>Page ID</th>
            <th>Token</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% savedPages.forEach(function(p) { %>
          <tr>
            <td><strong><%= p.name %></strong></td>
            <td><code><%= p.pageId %></code></td>
            <td><span class="badge <%= p.valid ? 'badge-green' : 'badge-red' %>"><%= p.valid ? 'Hợp lệ' : 'Hết hạn' %></span></td>
            <td>
              <div class="btn-group">
                <form method="POST" action="/settings/switch" style="display:inline">
                  <input type="hidden" name="pageId" value="<%= p.pageId %>">
                  <button type="submit" class="btn btn-sm btn-primary">Sử dụng</button>
                </form>
                <form method="POST" action="/settings/delete" style="display:inline">
                  <input type="hidden" name="pageId" value="<%= p.pageId %>">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xóa page này?')">Xóa</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>
