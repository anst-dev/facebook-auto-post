# Facebook API Credentials
# Get these from: https://developers.facebook.com/
# 1. Create a Facebook App
# 2. Add "Facebook Login" product
# 3. Get Page Access Token with permissions: pages_manage_posts, pages_read_engagement
# 4. Get your Page ID from Facebook Page Settings > About

FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_ACCESS_TOKEN=your_page_access_token_here

# Optional: Default topic for auto-posting
DEFAULT_TOPIC=technology news today
